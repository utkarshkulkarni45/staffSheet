# Copy to .env (gitignored) before running:  cp .env.example .env
# Both docker compose and Spring Boot (dev profile) read this file.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=staffsheet
DB_USERNAME=staffsheet
DB_PASSWORD=change-me-local-dev-only

# Generate a real value: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-character-hex-string
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8080

# prod profile only
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
